# Copy this file to ".env" and fill in your keys.
# Get keys at https://app.alpaca.markets  (Paper account → API Keys on the home page)

# Paper trading (fake money, real market data). Required to trade on Alpaca.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET=

# Live trading (REAL money). Leave blank until the agent has proven itself on paper.
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET=
# Must be exactly "true" for the in-game "Go Live" button to work at all.
ALLOW_LIVE=false

PORT=3777
